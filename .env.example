# Copy to .env in this worktree and supply a Beijing-region API key locally.
# Native DashScope API; append /services/embeddings/text-embedding/text-embedding.
# Explicit file loading: DashScopeEmbedder.from_env(env_file=".env").
# Preview synthetic connectivity inputs: python examples/memory_embedding_smoke.py
# Only the explicit --live flag reads credentials and contacts the service.
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
